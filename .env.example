# PostgreSQL
POSTGRES_USER=lco
POSTGRES_PASSWORD=lco_secret
POSTGRES_DB=lco_attendance
POSTGRES_PORT=5434

# Backend (host networking — both host and containers use localhost)
DATABASE_URL=postgresql+psycopg://lco:lco_secret@127.0.0.1:5434/lco_attendance
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# Auth (backend) — set a strong secret in real environments
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend
VITE_API_URL=http://localhost:8000
